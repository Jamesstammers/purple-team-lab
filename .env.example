# ─────────────────────────────────────────────────────────────
#  Purple Team Lab — configuration
#  Copy this file to ".env" and adjust before running.
# ─────────────────────────────────────────────────────────────

# ── Elastic stack ────────────────────────────────────────────
# NOTE: verify the tag exists on docker.elastic.co before running.
STACK_VERSION=9.5.4
ELASTIC_PASSWORD=ChangeMe_Elastic123!
KIBANA_PASSWORD=ChangeMe_Kibana123!

# License: "trial" unlocks the FULL SIEM/detection feature set for 30 days
# (recommended for a detection lab). Switch to "basic" afterwards.
LICENSE=trial

ES_MEM=2g
ES_PORT=9200
KIBANA_PORT=5601

# Kibana encryption keys — REQUIRED for the detection engine / alerting.
# Each must be 32+ characters. start-lab.sh generates random ones on first
# run; only set these by hand if you're not using that script.
ENCRYPTION_KEY=change_me_to_a_random_32char_string_aaaaaa
SO_ENCRYPTION_KEY=change_me_to_a_random_32char_string_bbbbbb
REPORTING_KEY=change_me_to_a_random_32char_string_cccccc

# ── Tuoni C2 ──────────────────────────────────────────────────
# The community edition installs via its own repo; start-lab.sh clones and
# starts it for you. No licence key needed. UI: localhost:12702
#
# TUONI_FQDN: the host browsers use to reach the Tuoni server (this machine's
# LAN IP or DNS name). Leave blank to auto-detect. Set it for team access so
# teammates don't need a hosts-file entry. Accept the self-signed cert once
# per browser at https://<TUONI_FQDN>:8443.
TUONI_FQDN=

# Auto-save a "clean" disk snapshot once the target is provisioned (1=on, 0=off).
# One-time; never overwrites an existing baseline. Revert: ./snapshot.sh restore clean
AUTO_SNAPSHOT=1

# Telemetry ingest mode:
#   winlogbeat    — simple, single binary (partial Sysmon ECS mapping)
#   elastic-agent — Fleet Server + Elastic Agent + Windows integration
#                   (full ECS: destination.ip etc., more rules fire)
INGEST=winlogbeat

# ── Windows target (dockur/windows — full Windows VM under KVM) ─
# WIN_VERSION examples: 2022, 2025, 11, tiny11, 2019
WIN_VERSION=2022
WIN_RAM=4G
WIN_CPU=2
WIN_DISK=48G
WIN_USERNAME=labadmin
WIN_PASSWORD=Purple_Team_Lab123!
WIN_RDP_PORT=3389
WIN_SSH_PORT=2222
WIN_VIEW_PORT=8006
